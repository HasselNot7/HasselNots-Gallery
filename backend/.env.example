# Required — JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional — comma-separated allowed origins when the API is called cross-origin.
# Same-origin deployments (Next.js rewrites) do not need CORS.
CORS_ORIGINS=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gallery
R2_PUBLIC_URL=
